# Database Configuration
DBUSER=postgres
DBPASS=he@ven401
DBNAME=Bantu_db
DBHOST=localhost
DBPORT=5432

# GCP Configuration
GCP_PROJECT_ID=bantuai
GCP_REGION=africa_south1
GCP_DATASTORE_PROJECT_ID=your-project-id
GCP_STORAGE_BUCKET=ntu-storage

# Security settings
ACCESS_SECRET_KEY="some-random-string-secret-key-that-is-very-long-and-secure"
REFRESH_SECRET_KEY="some- other- random-string-refresh-secret-key-that-is-very-long-and-secure"
ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ALGORITHM="HS256"
REFRESH_TOKEN_EXPIRE_DAYS=5

# FastAPI Configuration
API_SECRET_KEY="some-random-string-secret-key-that-is-very-long-and-secure"
API_ALGORITHM=HS256
API_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Model Inference
MODEL_INFERENCE_HOST=localhost
MODEL_INFERENCE_PORT=8001

# Frontend
FRONTEND_URL=http://localhost:5173

# HuggingFace
HUGGINGFACE_API_TOKEN=your-hf-token
HUGGINGFACE_MODEL_REPO=your-model-repo

# Kubernetes
K8S_NAMESPACE=ntu
K8S_SERVICE_ACCOUNT=ntu-service-account

# Security
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO

# Cache
REDIS_HOST=localhost
REDIS_PORT=6379
