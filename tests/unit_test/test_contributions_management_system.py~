        AnnotationContribution(id=uuid4()),
        AnnotationContribution(id=uuid4())
    ]
    mock_result = MagicMock()
    mock_result.scalars.return_value.all.return_value = mock_contributions
    mock_db.execute.return_value = mock_result

    filters = ContributionFilter(
        user_id=uuid4(),
        active=True,
        created_after=datetime.now() - timedelta(days=7)
    )

    results = await service.list_contributions(
        contribution_type="annotation",
        filters=filters,
        skip=0,
        limit=10
    )

    assert len(results) == 2
    assert mock_db.execute.called


@pytest.mark.asyncio
