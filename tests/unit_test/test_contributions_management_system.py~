@pytest.fixture
def mock_db():
    db = AsyncMock(spec=AsyncSession)
    db.execute = AsyncMock()
    db.commit = AsyncMock()
    db.refresh = AsyncMock()
    return db


@pytest.fixture
def service(mock_db):
    from services.contribution_management_service import ContributionManagementService
    return ContributionManagementService(mock_db)


@pytest.mark.asyncio
async def test_create_contribution(service, mock_db):
    user_id = uuid4()
    sample_id = uuid4()
    data = ContributionCreate(
        target_text="Test text",
        target_language_id=uuid4()
    )

    # Mock the execute response
    mock_result = MagicMock()
    mock_result.scalars.return_value.first.return_value = None
    mock_db.execute.return_value = mock_result

    # Test annotation contribution
    contribution = await service.create_contribution(
        user_id=user_id,
        contribution_type="annotation",
        sample_id=sample_id,
        data=data
    )

    assert mock_db.add.called
    assert mock_db.commit.called
    assert isinstance(contribution, AnnotationContribution)


